// ABI contract for third-party API Gateway plugins.
// Kept in sync with crates/octra-api-plugin-wasm/wit/plugin.wit.

package octra:api-plugin@1.0.0;

interface types {
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    record request {
        request-id: string,
        method: string,
        path: string,
        query: string,
        headers: list<tuple<string, string>>,
        client-ip: option<string>,
        consumer-id: option<string>,
        route-id: string,
        service-id: string,
    }

    record reject {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record request-mutation {
        path: option<string>,
        query: option<string>,
        set-headers: list<tuple<string, string>>,
        remove-headers: list<string>,
    }

    variant action {
        continue(request-mutation),
        reject(reject),
    }

    record response {
        request-id: string,
        status: u16,
        headers: list<tuple<string, string>>,
        consumer-id: option<string>,
        route-id: string,
        service-id: string,
    }

    record response-mutation {
        status: option<u16>,
        set-headers: list<tuple<string, string>>,
        remove-headers: list<string>,
    }

    variant response-action {
        continue(response-mutation),
        reject(reject),
    }

    record log-entry {
        request-id: string,
        method: string,
        path: string,
        status: u16,
        latency-ms: u64,
        consumer-id: option<string>,
        route-id: string,
        service-id: string,
    }
}

interface host {
    use types.{log-level};

    log: func(level: log-level, message: string);
    now-unix: func() -> s64;
    instance-id: func() -> string;

    kv-get: func(key: string) -> result<option<string>, string>;
    kv-put: func(key: string, value: string, ttl-seconds: option<u32>) -> result<_, string>;
    kv-delete: func(key: string) -> result<bool, string>;
    kv-incr: func(key: string, delta: s64, ttl-seconds: option<u32>) -> result<s64, string>;

    entity-get: func(entity: string, key-json: string) -> result<option<string>, string>;
    entity-upsert: func(entity: string, values-json: string) -> result<_, string>;
    entity-increment: func(
        entity: string,
        key-json: string,
        field: string,
        delta: s64,
        extra-json: option<string>,
    ) -> result<s64, string>;
    entity-delete: func(entity: string, key-json: string) -> result<bool, string>;
    entity-query: func(entity: string, query-json: string) -> result<string, string>;
}

interface plugin-api {
    use types.{request, response, action, response-action, log-entry};

    configure: func(config-json: string) -> result<_, string>;
    on-request: func(req: request) -> result<action, string>;
    on-response: func(resp: response) -> result<response-action, string>;
    on-log: func(entry: log-entry);
}

world plugin {
    import host;
    export plugin-api;
}
